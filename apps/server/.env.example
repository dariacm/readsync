ELEVENLABS_API_KEY=your-api-key-here
# Optional overrides
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Expands English abbreviations like "e.g."; create it with `pnpm dictionary:create en`
# ELEVENLABS_PRONUNCIATION_DICTIONARY_ID_EN=
# PORT=8787
# Cache generated speech in Supabase Storage (see the README); set both or neither
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_SPEECH_BUCKET=speech-cache
# Replay the recorded demo instead of calling ElevenLabs (what `pnpm dev:demo` sets)
# READSYNC_DEMO=true
