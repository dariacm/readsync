{
  "name": "@readsync/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:demo": "READSYNC_DEMO=true tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "dictionary:create": "tsx --env-file=.env scripts/createPronunciationDictionary.ts",
    "demo:record": "tsx --env-file=.env scripts/recordDemo.ts",
    "cache:prune": "tsx --env-file=.env scripts/pruneSpeechCache.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@readsync/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
